{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "📊 Habitual Quick Add",
                  "weight": "Bolder",
                  "size": "Medium",
                  "color": "Accent"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "horizontalAlignment": "Right",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${dateStr}",
                  "size": "Small",
                  "isSubtle": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "Active Daily Goals",
          "weight": "Bolder",
          "spacing": "Medium"
        },
        {
          "type": "Container",
          "$data": "${habits}",
          "separator": true,
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${name}",
                      "weight": "Bolder",
                      "wrap": true
                    },
                    {
                      "type": "TextBlock",
                      "text": "🔥 ${streak} day streak • Progress: ${completedCount}/${dailyTarget}",
                      "size": "Small",
                      "isSubtle": true
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "Center",
                  "items": [
                    {
                      "type": "ActionSet",
                      "actions": [
                        {
                          "type": "Action.Submit",
                          "title": "${statusIcon}",
                          "data": {
                            "verb": "quick-add",
                            "habitId": "${id}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Open Habitual App",
      "data": {
        "verb": "open-app"
      }
    }
  ]
}
