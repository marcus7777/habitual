{
  "name": "functions",
  "description": "Firebase Cloud Functions for Habitual habit sharing signature verification",
  "scripts": {
    "serve": "firebase serve --only functions",
    "emulators": "JAVA_HOME=/home/marcus/Documents/android-studio/jbr PATH=/home/marcus/Documents/android-studio/jbr/bin:$PATH firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "test": "JAVA_HOME=/home/marcus/Documents/android-studio/jbr PATH=/home/marcus/Documents/android-studio/jbr/bin:$PATH firebase emulators:exec --only functions,firestore \"node ../tests/test-cloud-functions.js\"",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "private": true
}
